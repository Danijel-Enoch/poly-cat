# Copy to .env.local for local dev, or set these in your hosting provider's
# environment variable config (e.g. Vercel project settings) for deployments.

NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545

# Powers RainbowKit's wallet list (see lib/wagmi.ts) — required for its
# WalletConnect-based connectors to work on mobile browsers, which usually have
# no injected-provider extension to fall back on. Get a free project ID at
# https://cloud.reown.com — without it, only injected wallets (desktop browser
# extensions) can connect. NEXT_PUBLIC_APP_URL only affects the name/icon shown
# inside RainbowKit's modal and the connecting wallet app, not functionality.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Deployed MarketFactory address from `forge script script/Deploy.s.sol
# --broadcast` against local Anvil (the ERC1967Proxy address, not the
# implementation — see packages/contracts). Trading is native ETH, so there's
# no separate collateral token address to set.
NEXT_PUBLIC_MARKET_FACTORY_ADDRESS=0x9fe46736679d2d9a65f0992f2272de9f3c7fa6e0

# Set NEXT_PUBLIC_NETWORK=mainnet once NEXT_PUBLIC_MAINNET_MARKET_FACTORY_ADDRESS
# is filled in below to point the app at Robinhood Chain instead of local
# Anvil (see lib/wagmi.ts, lib/chains.ts, and lib/contracts.ts). Only
# NEXT_PUBLIC_MAINNET_MARKET_FACTORY_ADDRESS actually throws at startup if
# missing (lib/contracts.ts's requireMainnetEnv) — the other mainnet vars
# below silently fall back (lib/chains.ts's `??` defaults) to the values
# already filled in here, or to chain ID 0 / an empty RPC URL if you blank
# them out, so leaving one unset misconfigures the chain rather than failing
# loudly. Network metadata below is real/public (chain ID confirmed via
# eth_chainId against the RPC url); the contract address is not, since
# MarketFactory isn't deployed to mainnet yet.
NEXT_PUBLIC_NETWORK=local
NEXT_PUBLIC_MAINNET_CHAIN_ID=4663
NEXT_PUBLIC_MAINNET_CHAIN_NAME=Robinhood Chain
NEXT_PUBLIC_MAINNET_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_MAINNET_EXPLORER_URL=https://robinhoodchain.blockscout.com
NEXT_PUBLIC_MAINNET_CURRENCY_NAME=Ether
NEXT_PUBLIC_MAINNET_CURRENCY_SYMBOL=ETH
NEXT_PUBLIC_MAINNET_MARKET_FACTORY_ADDRESS=
