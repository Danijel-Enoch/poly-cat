# Copy to .env.local for local dev, or set these in your hosting provider's
# environment variable config (e.g. Vercel project settings) for deployments.

NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_PONDER_URL=http://localhost:42069

# Optional market images are pinned to IPFS via Pinata rather than stored
# on-chain — only the resulting CID is written into metadataURI (see
# lib/category.ts). Leave PINATA_JWT unset to disable the image picker
# entirely (app/api/upload-image returns 501). PINATA_JWT is server-only:
# the route handler at app/api/upload-image uses it to call Pinata's pinning
# API so the secret never reaches the browser. Get a JWT from
# https://app.pinata.cloud/developers/api-keys.
# NEXT_PUBLIC_IPFS_GATEWAY_URL is the public, read-only gateway used to
# render images back — Pinata's shared gateway works out of the box, or use
# your own dedicated gateway domain from the Pinata dashboard.
PINATA_JWT=
NEXT_PUBLIC_IPFS_GATEWAY_URL=https://gateway.pinata.cloud

# Admin "verified market" tags are stored off-chain in Redis (not part of
# the on-chain Market struct — see lib/verifiedMarkets.ts) so the admin can
# toggle them without a contract upgrade. Leave unset to disable
# verification entirely (badges just never show, and the admin toggle fails
# with a clear error instead of silently no-opping). Server-only — read by
# app/api/admin/verify-market and app/api/verified-markets, never sent to
# the browser. Point this at any reachable Redis instance, e.g.
# redis://user:password@host:6379 (add rediss:// instead of redis:// if it
# requires TLS).
REDIS_URL=

# Lets the admin dashboard's "Import from Polymarket" panel (and the
# standalone `pnpm web:import-markets` script) pull trending markets from
# Polymarket's public Gamma API, have an LLM (via OpenRouter) pick the
# "major" ones and categorize them, and skip anything already on HoodMarkets
# — see lib/marketImport.ts. Also powers the "Research with AI" button in the
# admin dashboard's "Ready to settle" list, which looks up a matching
# Polymarket market and asks an OpenRouter model (with its web-search plugin
# — see the ":online" suffix in lib/openrouter.ts) what actually happened, as
# a documented recommendation for the admin — it never calls settleMarket
# itself. Leave OPENROUTER_API_KEY unset to disable both features (the routes
# return an error and the script hard-fails with a clear message, same as the
# PINATA_JWT pattern above). Get a key at https://openrouter.ai/keys.
# Server-only — never sent to the browser.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
POLYMARKET_API_URL=https://gamma-api.polymarket.com
# Raw human-unit USDC/USDG seeded into each imported market (e.g. "10" = $10)
# — also used to compute how many markets the admin's balance affords. Never
# goes below the contract's own minInitialLiquidity floor even if set lower.
IMPORT_MARKET_LIQUIDITY_USDC=10
# `pnpm web:import-markets` (the standalone CLI script) only — never read by
# the Next.js app itself, and NOT needed for the admin-dashboard import flow,
# which signs createMarket transactions with the admin's own connected
# wallet instead. The wallet this key controls must hold USDC/USDG (to seed
# each market) and ETH (for gas).
PRIVATE_KEY=

# Needed for wallet connect to work on mobile browsers, which usually have no
# injected-provider extension to fall back on (see lib/wagmi.ts). Get a free
# project ID at https://cloud.reown.com — without it, only injected wallets
# (desktop browser extensions) can connect. NEXT_PUBLIC_APP_URL only affects
# the name/icon shown inside the connecting wallet app, not functionality.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Deployed contract addresses from `forge script script/Deploy.s.sol --broadcast`
# against local Anvil (the ERC1967Proxy address for MarketFactory, not the
# implementation — see packages/contracts) and MockUSDC.
NEXT_PUBLIC_MARKET_FACTORY_ADDRESS=0x9fe46736679d2d9a65f0992f2272de9f3c7fa6e0
NEXT_PUBLIC_MOCK_USDC_ADDRESS=0x5fbdb2315678afecb367f032d93f642f64180aa3

# Set NEXT_PUBLIC_NETWORK=mainnet once NEXT_PUBLIC_MAINNET_MARKET_FACTORY_ADDRESS
# is filled in below to point the app at Robinhood Chain instead of local
# Anvil (see lib/wagmi.ts and lib/contracts.ts). None of these have hardcoded
# fallbacks — the app throws at startup if NEXT_PUBLIC_NETWORK=mainnet and any
# required one below is missing. Network metadata below is real/public
# (chain ID confirmed via eth_chainId against the RPC url); the contract
# address is not, since MarketFactory isn't deployed to mainnet yet.
NEXT_PUBLIC_NETWORK=local
NEXT_PUBLIC_MAINNET_CHAIN_ID=4663
NEXT_PUBLIC_MAINNET_CHAIN_NAME=Robinhood Chain
NEXT_PUBLIC_MAINNET_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_MAINNET_EXPLORER_URL=https://robinhoodchain.blockscout.com
NEXT_PUBLIC_MAINNET_CURRENCY_NAME=Ether
NEXT_PUBLIC_MAINNET_CURRENCY_SYMBOL=ETH
NEXT_PUBLIC_MAINNET_MARKET_FACTORY_ADDRESS=
# Real USDG ("Global Dollar") on Robinhood Chain mainnet — not USDC. See the
# UI-copy note in DOCS.md before flipping to mainnet.
NEXT_PUBLIC_MAINNET_USDC_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
