# Copy to .env.local (or export directly) before running `forge script`.
# Defaults to Anvil's default account #0 key if unset — fine for local dev,
# never use that well-known key for a real deployment.
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Not read automatically by any script — pass explicitly via `--rpc-url`, e.g.:
#   forge script script/Deploy.s.sol --rpc-url $ROBINHOOD_RPC_URL --broadcast
ROBINHOOD_RPC_URL=
