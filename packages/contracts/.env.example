# Copy to .env.local (or export directly) before running `forge script`.

# Deploy.s.sol and EnvCheck.s.sol fall back to `0x1` if this is unset — a
# throwaway key with no funds on a fresh chain, not Anvil's real account #0.
# For local Anvil use, set this explicitly to Anvil's account #0 key (shown
# below); for a real deployment, use a dedicated deployer key, never this
# well-known one. Upgrade.s.sol has no fallback at all — it hard-requires
# this to be set and reverts otherwise.
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Not read automatically by any script — pass explicitly via `--rpc-url`, e.g.:
#   forge script script/Deploy.s.sol --rpc-url $ROBINHOOD_RPC_URL --broadcast
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# --- Only needed when running script/Upgrade.s.sol ---

# The already-deployed MarketFactory proxy (ERC1967Proxy) to push a new
# implementation to. Required — Upgrade.s.sol reverts if unset. Never the
# implementation address; see the root DOCS.md for proxy vs. implementation.
MARKET_FACTORY_PROXY_ADDRESS=

# Optional. ABI-encoded call (e.g. from `cast calldata`) run atomically via
# delegatecall right after the implementation swap, in the same transaction —
# for new state a fresh `initialize()` didn't set. Defaults to a no-op.
POST_UPGRADE_CALLDATA=
