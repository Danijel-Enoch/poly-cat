# Copy to .env.local before running `pnpm dev` (or `pnpm indexer:dev` from
# the repo root). Same chain-selection convention as packages/cron/.env.example
# and packages/web/.env.example — one active network at a time, local Anvil
# by default.

RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337

# The deployed MarketFactory proxy address (see packages/contracts).
MARKET_FACTORY_ADDRESS=

# Block to start indexing from. Leave unset (defaults to 0) against local
# Anvil, which resets on every restart anyway. Against a real chain, set this
# to the contract's actual deploy block — see packages/contracts/addresses.txt
# for the "Block:" value logged by `forge script script/Deploy.s.sol
# --broadcast` — so indexing doesn't scan every block back to genesis.
START_BLOCK=

# Optional. Defaults to an on-disk SQLite database (fine for local dev). Set
# a Postgres connection string for anything longer-lived than a laptop —
# `ponder start` in production, or any deployment that needs to survive a
# restart with its indexed history intact.
DATABASE_URL=
