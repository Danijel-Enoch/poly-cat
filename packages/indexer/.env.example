# Copy to .env.local before running `pnpm dev` (or `pnpm indexer:dev` from
# the repo root). Same chain-selection convention as packages/cron/.env.example
# and packages/web/.env.example — one active network at a time, local Anvil
# by default.

RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337

# The deployed MarketFactory proxy address (see packages/contracts).
MARKET_FACTORY_ADDRESS=

# Block to start indexing from. Leave unset (defaults to 0) against local
# Anvil, which resets on every restart anyway. Against a real chain, set this
# to the contract's actual deploy block — see packages/contracts/addresses.txt
# for the "Block:" value logged by `forge script script/Deploy.s.sol
# --broadcast` — so indexing doesn't scan every block back to genesis.
START_BLOCK=

# Required by `pnpm start` (production mode, i.e. `ponder start`) — `pnpm dev`
# doesn't need this, it defaults to "public". Ponder refuses to boot in
# production without an explicit schema so two deployments can never
# accidentally collide on the same one.
DATABASE_SCHEMA=public

# Optional. Without this, Ponder falls back to an on-disk PGlite (embedded
# Postgres) database under .ponder/ — fine for local dev, but it won't
# survive a container restart or scale past one instance. Set a real Postgres
# connection string for `pnpm start` in production, or any deployment that
# needs to survive a restart with its indexed history intact.
DATABASE_URL=

# Optional. Port the API server listens on (Ponder reads this directly).
# Only relevant if the default conflicts with something else on the host, or
# a container platform assigns its own port — see Dockerfile.indexer.
PORT=42069
