# Copy to .env.local for `ponder dev`, or pass to `docker run --env-file` /
# your host's env var config for `ponder start` in production.

# Local Anvil RPC (started via `anvil` in packages/contracts).
PONDER_RPC_URL_ANVIL=http://127.0.0.1:8545

# Deployed contract address from `forge script script/Deploy.s.sol --broadcast`
# (the ERC1967Proxy address, not the implementation — see packages/contracts).
MARKET_FACTORY_ADDRESS=0xcf7ed3acca5a467e9e704c703e8d87f634fb0fc9
START_BLOCK=0

# Required by `ponder start` (production mode) — `ponder dev` doesn't need this.
DATABASE_SCHEMA=public

# (Optional) Postgres database URL. If not provided, Ponder falls back to an
# on-disk PGlite database — fine for local dev, not for production (won't
# survive a container restart or scale past one instance).
DATABASE_URL=

# Robinhood Chain (mainnet) — set all four to also index the mainnet
# deployment (see ponder.config.ts). Leaving any of these unset keeps the
# indexer anvil-only, so this section is safe to leave blank until you deploy
# MarketFactory there.
PONDER_RPC_URL_ROBINHOOD=
ROBINHOOD_CHAIN_ID=
MARKET_FACTORY_ADDRESS_ROBINHOOD=
START_BLOCK_ROBINHOOD=
