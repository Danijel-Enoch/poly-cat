# Copy to .env.local before running `pnpm start` (or `pnpm cron:run` from the
# repo root).

# Chain to submit createMarket/settleMarket transactions to.
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337

# The deployed MarketFactory proxy address (see packages/contracts).
MARKET_FACTORY_ADDRESS=

# Must be the factory's current owner — see `factory.transferOwnership` /
# Deploy.s.sol. This account needs enough native ETH to cover both gas and
# each new market's seed liquidity, since createMarket sends
# `defaultInitialLiquidity` as msg.value directly from this wallet.
# Never commit a real key — use a dedicated hot wallet for this, not a
# multisig or an account holding anything beyond what it needs to operate.
CRON_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Optional. Comma-separated allowlist of asset symbols (e.g. "CASHCAT" or
# "BTC,CASHCAT") — when set, only these get a new 5-minute window opened for
# them; every other registered asset is skipped the same way an admin-paused
# one is (see src/assetStatus.ts), though any of their markets already
# Trading still settle normally. Leave unset for no restriction (default).
CRON_ACTIVE_SYMBOLS=

# Optional. Max assets (each up to one settle + one create) folded into a
# single `batchProcess` transaction. Defaults to 25 — sized so one tx stays
# well under a ~30M-gas block (~450k gas/asset worst case). Any excess is
# split across consecutive batches. Raise it on a chain with a higher block
# gas limit; lower it if you hit "exceeds block gas limit" reverts.
MAX_ASSETS_PER_BATCH=25

# Optional. A real, aggregate3-compatible Multicall3 contract address — set
# this to fold each pass's reads (getAsset/currentMarketId/getMarket across
# every registered asset) into one eth_call instead of firing them
# individually (see src/run.ts, src/chain.ts). Local Anvil has no Multicall3
# deployed by default, so leave this unset there. On Robinhood Chain
# mainnet, use the canonical 0xcA11bde05977b3631167028862bE2a173976CA11 —
# confirmed deployed and aggregate3-compatible there. NOT the chain's own
# "L2 Multicall" contract at 0x2cAC2D899eCC914d704FeaAE33ac1bF36277DaD1,
# which has code but doesn't implement aggregate3 (confirmed empirically —
# it reverts even with zero sub-calls) and would silently break every read
# this script makes, not just the batched ones.
MULTICALL3_ADDRESS=
