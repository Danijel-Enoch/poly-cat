# Copy to .env.local before running `pnpm start` (or `pnpm cron:run` from the
# repo root).

# Chain to submit createMarket/settleMarket transactions to.
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337

# The deployed MarketFactory proxy address (see packages/contracts).
MARKET_FACTORY_ADDRESS=

# Must be the factory's current owner — see `factory.transferOwnership` /
# Deploy.s.sol. This account needs native gas and, since createMarket seeds
# every new market's liquidity from its own balance, a collateral-token
# approval to the factory (Deploy.s.sol sets this up for local deploys).
# Never commit a real key — use a dedicated hot wallet for this, not a
# multisig or an account holding anything beyond what it needs to operate.
CRON_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
